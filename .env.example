# Copy to .env. Everything is optional for local dev except what the feature you're
# working on needs. Never commit .env.

ENV=dev
PUBLIC_BASE_URL=http://localhost:8000      # your tunnel URL when testing real calls
DATABASE_URL=sqlite:///./pehchana.db       # docker compose Postgres: postgresql+psycopg://pk:pk@localhost:5432/pk
CORS_ORIGINS=["http://localhost:3000"]
CALLER_HASH_SALT=change-me                 # random string; never reuse across envs
ADMIN_TOKEN=change-me

# Bolna  (https://platform.bolna.ai)
BOLNA_API_KEY=
BOLNA_SHARED_SECRET=change-me              # sent back to us by agents on function calls
ENFORCE_BOLNA_IP_ALLOWLIST=false
BOLNA_AGENT_ID_KALPA=
BOLNA_AGENT_ID_CARTESIA=
BOLNA_AGENT_ID_SARVAM=
BOLNA_NUMBER_KALPA=                        # inbound number assigned to that agent (E.164)
BOLNA_NUMBER_CARTESIA=
BOLNA_NUMBER_SARVAM=

# Human control arm: volunteers on shift, comma-separated E.164
HUMAN_ARM_NUMBERS=

# Telephony  (public game number); TELEPHONY_PROVIDER picks the vendor
TELEPHONY_PROVIDER=plivo

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=
CONSENT_AUDIO_URL=                         # hosted mp3 of the consent notice (falls back to TTS)
CALLER_CHANNEL=0                           # stereo channel holding the caller; verify Day 1

# Deepgram  (post-call transcription)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# Anthropic  (post-call giveaway tagging)
ANTHROPIC_API_KEY=
TAGGER_MODEL=claude-opus-5

# Leaderboard
REVEAL_VENDORS=false
INCLUDE_DEMO_DATA=false

# Web (Next.js)
API_URL=http://localhost:8000
